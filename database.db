
PRAGMA foreign_keys = ON;

CREATE TABLE client (
    id_client   VARCHAR(15) PRIMARY KEY,
    nom         VARCHAR(200) NOT NULL,
    email       VARCHAR(50),
    adresse     VARCHAR(200)
);

CREATE TABLE utilisateur (
    id_utilisateur      VARCHAR(20) PRIMARY KEY,
    nom_utilisateur     VARCHAR(200) NOT NULL,
    prenom_utilisateur  VARCHAR(200) NOT NULL,
    mot_de_passe        VARCHAR(255) NOT NULL,   -- élargi pour hash (voir note ci-dessous)
    role                VARCHAR(20) NOT NULL
        CHECK (role IN ('admin', 'gestionnaire', 'commercial', 'employe'))
);

CREATE TABLE service (
    id_service          VARCHAR(10) PRIMARY KEY,
    nom                 VARCHAR(200) NOT NULL,
    description         TEXT,
    prix_unitaire_ser   FLOAT NOT NULL,
    unite               VARCHAR(20),
    type                VARCHAR(30) NOT NULL
);

CREATE TABLE devis (
    numero_devis    VARCHAR(12) PRIMARY KEY,
    date_creation   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_validation DATE,
    statut          VARCHAR(20) NOT NULL DEFAULT 'brouillon'
        CHECK (statut IN ('brouillon', 'valide', 'annule')),
    id_client       VARCHAR(15) NOT NULL,
    id_utilisateur  VARCHAR(20) NOT NULL,
    FOREIGN KEY (id_client) REFERENCES client(id_client),
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateur(id_utilisateur)
);

CREATE TABLE ligne_devis (
    id_ligne      VARCHAR(16) PRIMARY KEY,
    designation   VARCHAR(50),
    quantite      FLOAT NOT NULL,
    prix_unitaire DOUBLE NOT NULL,
    numero_devis  VARCHAR(12) NOT NULL,
    id_service    VARCHAR(10) NOT NULL,
    FOREIGN KEY (numero_devis) REFERENCES devis(numero_devis) ON DELETE CASCADE,
    FOREIGN KEY (id_service) REFERENCES service(id_service)
);

CREATE TABLE facture (
    numero_facture  VARCHAR(15) PRIMARY KEY,
    date_creation   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_echeance   DATETIME,
    statut          VARCHAR(20) NOT NULL DEFAULT 'impayee'
        CHECK (statut IN ('impayee', 'partiellement_payee', 'payee')),
    numero_devis    VARCHAR(12) NOT NULL UNIQUE,   -- 1,1 <-> 0,1 => unicité
    FOREIGN KEY (numero_devis) REFERENCES devis(numero_devis)
);

CREATE TABLE paiement (
    code_paiement   VARCHAR(30) PRIMARY KEY,
    date_paiement   DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    montant         DOUBLE NOT NULL,
    mode_paiement   VARCHAR(20) NOT NULL
        CHECK (mode_paiement IN ('especes', 'cheque', 'virement', 'carte', 'mobile_money')),
    numero_facture  VARCHAR(15) NOT NULL,
    FOREIGN KEY (numero_facture) REFERENCES facture(numero_facture)
);